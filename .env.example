DATABASE_URL=postgres://grove:grove@localhost:5432/grove
REDIS_URL=redis://localhost:6379
GROVE_MAGIC_LINK_STDOUT=1
GROVE_LISTEN_HOST=127.0.0.1
GROVE_WEB_ORIGIN=https://q-ai.tail735569.ts.net:3510
GROVE_PUBLIC_URL=https://q-ai.tail735569.ts.net:3510
GROVE_API_PORT=3511
GROVE_API_ORIGIN=http://127.0.0.1:3511
NEXT_PUBLIC_WS_ORIGIN=https://q-ai.tail735569.ts.net:3510
INVITE_BOOTSTRAP=grove-alpha

# Migrations are a deliberate act: run `pnpm migrate`. The API does NOT migrate on
# boot unless this is set to exactly "1" (anything else leaves it off). Off, the
# API names any unapplied migration at startup and serves anyway; on, a failed
# migration is fatal and the API exits rather than serve a mismatched schema.
# Leave this UNSET on the Mini: launchd and the watchdog bounce the service, and
# a boot migration would apply whatever .sql is on disk at that moment.
# GROVE_MIGRATE_ON_BOOT=1

# Optional: first login for this email becomes world operator
# GROVE_DEV_OPERATOR_EMAIL=you@example.com
# Non-production: POST /api/v1/ops/bootstrap promotes the current human
# GROVE_BOOTSTRAP_OPERATOR=1

# Pixel campus (also ?pixel=1 or localStorage grove-pixel=1)
# NEXT_PUBLIC_GROVE_PIXEL=1

# Hosted brains: LEAVE UNSET on this Mini. Inhabitants are infra/inhabitants (LM Studio / canned).
# Do not point Grove at api.x.ai. Do not put the Grok subscription key here.
# XAI_API_KEY=
# XAI_BASE_URL=http://127.0.0.1:8645/v1
# XAI_MODEL=grok-4.6

# Production email: Resend or SMTP. Without either, magic links only log when GROVE_MAGIC_LINK_STDOUT=1
# RESEND_API_KEY=
# GROVE_MAIL_FROM=Grove <noreply@example.com>
# GROVE_SMTP_URL=smtp://user:pass@host:587

# Vercel + Supabase: leave REDIS_URL unset (or REDIS_URL=pg). Sessions, rate
# limits and pub/sub then live in Postgres. Mini keeps using Redis.
# REDIS_URL=pg
# NEXT_PUBLIC_GROVE_BASE=
