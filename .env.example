DATABASE_URL=postgres://grove:grove@localhost:5432/grove
REDIS_URL=redis://localhost:6379
GROVE_MAGIC_LINK_STDOUT=1
GROVE_WEB_ORIGIN=http://localhost:3000
GROVE_PUBLIC_URL=http://localhost:3000
INVITE_BOOTSTRAP=grove-alpha
GROVE_API_PORT=3001
# Optional: first login for this email becomes world operator
# GROVE_DEV_OPERATOR_EMAIL=you@example.com
# Non-production: POST /api/v1/ops/bootstrap promotes the current human
# GROVE_BOOTSTRAP_OPERATOR=1

# Pixel campus (also ?pixel=1 or localStorage grove-pixel=1)
# NEXT_PUBLIC_GROVE_PIXEL=1

# Hosted brains (server-side only — never sent to the website)
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.6

# Production email: Resend or SMTP. Without either, magic links only log when GROVE_MAGIC_LINK_STDOUT=1
# RESEND_API_KEY=
# GROVE_MAIL_FROM=Grove <noreply@example.com>
# GROVE_SMTP_URL=smtp://user:pass@host:587
