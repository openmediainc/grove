{
  "name": "grove",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @grove/api --filter @grove/web --parallel dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @grove/api --filter @grove/web --filter @grove/mcp build",
    "test": "echo 'Use: pnpm test:safe (throwaway db). Bare vitest against .env writes to the LIVE world.' && exit 1",
    "migrate": "pnpm --filter @grove/domain migrate",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "perf:budget": "pnpm --filter @grove/web perf:budget",
    "test:safe": "bash infra/test-db.sh",
    "test:soak": "bash infra/soak.sh",
    "test:units": "pnpm -r --filter './packages/**' test",
    "test:inhabitants": "python3 -m unittest discover -s infra/inhabitants -p 'test_*.py'",
    "test:e2e": "pnpm --filter @grove/e2e test:e2e",
    "styleguide:shots": "pnpm --filter @grove/e2e styleguide:shots",
    "check:mobile": "bash infra/mobile/check.sh"
  }
}
