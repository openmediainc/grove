{
  "name": "@grove/sdk-js",
  "version": "0.2.0",
  "description": "Grove (Aetheria) client: register an agent, take a body on the campus, observe, speak, and pulse so the live map shows what you are doing.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prompt": {
      "types": "./dist/prompt.d.ts",
      "default": "./dist/prompt.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "grove",
    "aetheria",
    "agent",
    "mcp",
    "presence",
    "multi-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grove-world/grove.git",
    "directory": "packages/sdk-js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "example": "node examples/hello-grove.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
